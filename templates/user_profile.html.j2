{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display with context %}

<div class="container mt-5">

  <!-- User Profile Information Card -->
  <div class="card col-lg-8 mx-auto">
    <div class="row g-0 align-items-center">
      <div class="col-md-12">
        <div class="card-body">
          <h2 class="card-title">{{ user_display(user.username, show_tag=session.get('user_id') != user.id) }}
          {% if session.get('user_id') == user.id %}
          <form class="d-inline" method="post" action="{{ url_for('select_clan_tag', username=user.username) }}">
            <label class="visually-hidden" for="clan-tag">Clan tag</label>
            <select id="clan-tag" class="form-select d-inline" style="width: auto" name="community" onchange="this.form.submit()"{% if not available_tags %} disabled aria-describedby="clan-tag-rules"{% endif %}>
              <option value="">No clan tag</option>
              {% for tag in available_tags %}<option value="{{ tag.public_id }}" {% if user.clan_tag_id == tag.id %}selected{% endif %}>{{ tag.public_id }}</option>{% endfor %}
            </select><script> { const selector = document.getElementById("clan-tag"); selector.style.width = (selector.getBoundingClientRect().width * 1.5) + "px"; } </script>{% if available_tags %}<noscript><button type="submit">Save tag</button></noscript>{% endif %}
          </form>{% endif %}</h2>
          {% if session.get('user_id') == user.id and not available_tags %}<p id="clan-tag-rules" class="small text-muted">Join a community and make 3 posts there, each with reactions or comments from 10 distinct other users, to unlock its clan tag. Wilderness does not award a tag.</p>{% endif %}
          <p class="card-text text-muted mb-3">
            <strong>Location:</strong> {{ user.location or "N/A" }}<br>
            <strong>Birthdate:</strong> {{ user.birthdate or "N/A" }}<br>
            <strong>Joined:</strong> {{ user.created_at|datetimeformat }}
          </p>
          <p class="card-text">{{ user.profile or "No profile information provided." }}</p>

         {% if session.user_id and session.user_id != user.id %}
            <div class="my-3">
              {# The logic is now a simple boolean check #}
              {% if is_following %}
                <form action="{{ url_for('unfollow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-secondary">Unfollow</button>
                </form>
              {% else %}
                <form action="{{ url_for('follow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-primary">Follow</button>
                </form>
              {% endif %}
            </div>
          {% endif %}

          <div class="mt-4 d-flex">
            <div class="me-4">
              <a href="/u/{{ user.username }}/followers" class="text-decoration-none text-dark">
                <strong>{{ followers_count }}</strong> Followers
              </a>
            </div>
            <div>
              <a href="/u/{{ user.username }}/following" class="text-decoration-none text-dark">
                <strong>{{ following_count }}</strong> Following
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Posts</span></h3>

  <div class="row g-3">
    {% for post in posts %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <a href="{{ url_for('post_detail', post_id=post.id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <p class="card-text">{% if post.public_id == 'introduction' %}{{ post.content|truncate(100, True, '...')|e }}{% else %}{{ post.content|truncate(100, True, '...') }}{% endif %}</p>
            <small class="text-muted">Posted on {{ post.created_at|datetimeformat }}</small>
          </div>
        </a>
        <div class="px-3 pb-3">at <a href="{{ url_for('community_page', public_id=post.public_id) }}">/c/{{ post.public_id }}</a> as {{ (post.nickname or user.username)|e }}</div>
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No posts yet.</p>
    </div>
    {% endfor %}
  </div>

  <!-- User's Latest Comments Section -->
  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Comments</span></h3>

  <div class="row g-3">
    {% for comment in comments %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <!-- The link now goes to the post the comment is on -->
        <a href="{{ url_for('post_detail', post_id=comment.post_id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <!-- Display the comment content -->
            <p class="card-text">{{ comment.content|truncate(100, True, '...') }}</p>
            <!-- Updated text to show it's a comment -->
            <small class="text-muted">Commented on {{ comment.created_at|datetimeformat }}</small>
          </div>
        </a>
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No comments yet.</p>
    </div>
    {% endfor %}
  </div>

</div>
{% endblock %}
