  {% if request.endpoint == 'community_list' %}<button type="button" id="stay-civilized" class="btn btn-secondary">Stay civilized</button>{% else %}<a href="{{ url_for('community_list') }}" class="btn btn-secondary">Stay civilized</a>{% endif %}
</div>
